    "recentContributionsLimit10": {
      "plan": [
        {
          "detail": "CO-ROUTINE recent_contributions",
          "id": 2,
          "notused": 0,
          "parent": 0
        },
        {
          "detail": "SEARCH contributions USING INDEX idx_contributions_workspace (workspace_id=?)",
          "id": 9,
          "notused": 62,
          "parent": 2
        },
        {
          "detail": "SCAN recent_contributions",
          "id": 33,
          "notused": 49,
          "parent": 0
        },
        {
          "detail": "USE TEMP B-TREE FOR ORDER BY",
          "id": 51,
          "notused": 0,
          "parent": 0
        }
      ],
      "sql": "SELECT * FROM (\n      SELECT contributions.rowid AS entry_rowid, contributions.*\n      FROM contributions WHERE workspace_id = ? ORDER BY created_at DESC, contributions.rowid DESC LIMIT ?\n    ) AS recent_contributions ORDER BY created_at ASC, entry_rowid ASC"
    }
