    "listTasksPage20": {
      "plan": [
        {
          "detail": "SEARCH tasks USING INDEX idx_tasks_workspace (workspace_id=?)",
          "id": 7,
          "notused": 62,
          "parent": 0
        },
        {
          "detail": "USE TEMP B-TREE FOR ORDER BY",
          "id": 45,
          "notused": 0,
          "parent": 0
        }
      ],
      "sql": "SELECT *, (CASE status WHEN 'blocked' THEN 0 WHEN 'in_progress' THEN 1 WHEN 'open' THEN 2 ELSE 3 END) AS context_rank FROM tasks WHERE workspace_id = ? ORDER BY (CASE status WHEN 'blocked' THEN 0 WHEN 'in_progress' THEN 1 WHEN 'open' THEN 2 ELSE 3 END) ASC, updated_at DESC, id ASC LIMIT ?"
    },
    "pageContributionsLimit10": {
      "plan": [
        {
          "detail": "SEARCH contributions USING INDEX idx_contributions_workspace_position (workspace_id=? AND append_position<?)",
          "id": 7,
