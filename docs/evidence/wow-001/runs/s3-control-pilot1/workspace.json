    {
      "id": "find_acdd83e925614cdf",
      "workspace_id": "ws_f63f244b50b7471e",
      "summary": "IAD /v1/exports failures are gateway 504s caused by upstream timeout, not client-side or dashboard errors.",
      "detail": "In the request sample, gw-084 (09:46:08Z) and gw-093 (09:51:24Z) both returned status 504, duration 30000 ms, gateway_note=upstream_response_timeout. Successful IAD exports in the same window (gw-071 at 09:42:11Z, 820 ms; gw-101 at 09:55:06Z, 1460 ms) completed normally. The 30000 ms duration matches a gateway-side response timeout against an unresponsive upstream.",
      "confidence": 0.9,
      "source_artifact_id": null,
      "created_by_actor_id": "agt_aa9fd1acaaf24477",
      "created_by_actor_type": "agent",
