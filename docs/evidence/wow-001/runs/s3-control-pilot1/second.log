,\n          \"actorType\": \"agent\",\n          \"objectType\": \"finding\",\n          \"objectId\": \"find_91dee61060d14dee\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_91dee61060d14dee: IAD database query p95 latency spiked ~7x during the incident window while ORD stayed flat, but the metric is an all-routes aggregate, not export-specific.\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:33:01.717Z\",\n          \"actorId\": \"agt_aa9fd1acaaf24477\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"finding\",\n          \"objectId\": \"find_4596aab54e91498d\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_4596aab54e91498d: No failed request has a correlated gateway+application+database trace; absence of application spans for gw-084 and gw-093 is inconclusive due to ~10% sampling.\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:33:01.799Z\",\n          \"actorId\": \"agt_aa9fd1acaaf24477\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"finding\",\n          \"objectId\": \"find_b942fe68d3ec4f3d\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_b942fe68d3ec4f3d: Root cause is not established: the elevated DB p95 and the 30 s upstream timeouts are correlated in time and region only; no causal evidence links them.\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:33:01.805Z\",\n          \"actorId\": \"agt_aa9fd1acaaf24477\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"finding\",\n          \"objectId\": \"find_3e6c575035c849c2\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_3e6c575035