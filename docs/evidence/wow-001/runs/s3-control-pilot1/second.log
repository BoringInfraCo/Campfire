sionId\": \"dec_f949414ac9e4444f\",\n              \"findingId\": \"find_8ff0598092454a6e\",\n              \"note\": \"Establishes IAD-only scope and ~6.5% failure rate in the window.\",\n              \"createdBy\": {\n                \"actorId\": \"agt_aa9fd1acaaf24477\",\n                \"actorType\": \"agent\"\n              },\n              \"agentSessionId\": \"ses_2343397d1fb7494d\",\n              \"createdAt\": \"2026-10-08T04:33:19.488Z\"\n            },\n            {\n              \"id\": \"cit_457090407e7a4997\",\n              \"workspaceId\": \"ws_f63f244b50b7471e\",\n              \"decisionId\": \"dec_f949414ac9e4444f\",\n              \"findingId\": \"find_b942fe68d3ec4f3d\",\n              \"note\": \"Root cause unproven, so no safe remediation to approve.\",\n              \"createdBy\": {\n                \"actorId\": \"agt_aa9fd1acaaf24477\",\n                \"actorType\": \"agent\"\n              },\n              \"agentSessionId\": \"ses_2343397d1fb7494d\",\n              \"createdAt\": \"2026-10-08T04:33:19.554Z\"\n            },\n            {\n              \"id\": \"cit_b19595e11eb24660\",\n              \"workspaceId\": \"ws_f63f244b50b7471e\",\n              \"decisionId\": \"dec_f949414ac9e4444f\",\n              \"findingId\": \"find_4596aab54e91498d\",\n              \"note\": \"Missing correlated traces motivate the diagnostic next step.\",\n              \"createdBy\": {\n                \"actorId\": \"agt_aa9fd1acaaf24477\",\n                \"actorType\": \"agent\"\n              },\n              \"agentSessionId\": \"ses_2343397d1fb7494d\",\n              \"createdAt\": \"2026-10-08T04:33:19.626Z\"\n            },\n            {\n              \"id\": \"cit_e79bf7d827264f44\",\n              \"workspaceId\": \"ws_f63f244b50b7471e\",\n              \"decisionId\": \"dec_f949414ac9e4444f\",\n              \"findingId\": \"find_91dee61060d14dee\",\n              \"note\": \"DB p95 is all-routes aggregate, so export-specific confirmation is required.\",\n              \"createdBy\": {\n                \"actorId\": \"agt_aa9fd1acaaf24477\",\n                \"actorType\": \"agent\"\n              },\n              \"agentSessionId\": \"ses_2343397d1fb7494d\",\n              \"createdAt\": \"2026-10-08T04:33:19.728Z\"\n            }\n          ]\n        }\n      ],\n      \"total\": 1,\n      \"returned\": 1,\n      \"truncated\": false\n    },\n    \"findings\": {\n      \"items\": [\n        {\n          \"createdBy\": {\n            \"actorId\": \"agt_aa9fd1acaaf24477\",\n            \"actorType\": \"agent\"\n          },\n          \"agentSessionId\": \"ses_2343397d1fb7494d\",\n          \"createdAt\": \"2026-10-08T04:33:01.805Z\",\n          \"id\": \"find_3e6c575035c849c2\",\n          \"workspaceId\": \"ws_f63f244b50b7471e\",\n          \"summary\": \"Support reports implicate IAD only and note dashboard/read requests succeeded; support attempts also cannot be tied to specific gateway request IDs.\",\n          \"detail\": \"Support report: northstar (IAD) two export timeouts at 09:44 and 09:47, but same user opened the dashboard at 09:49; willow (IAD) one export timeout at 09:54 and an ordinary report-list request at 09:56 succeeded. No request IDs were captured. The support attempt times (09:44, 09:47, 09:54) do not exactly match the sampled failures gw-084 (09:46:08Z) and gw-093 (09:51:24Z), so specific customer requests cannot be confidently matched to sampled request IDs.\",\n          \"confidence\": 0.85,\n          \"currentness\": \"current\",\n          \"evidence\": [\n            {\n              \"id\": \"fev_3b15f5a03f194c8f\",\n              \"workspaceId\": \"ws_f63f244b50b7471e\",\n              \"findingId\": \"find_3e6c575035c849c2\",\n              \"artifactId\": \"art_d0b9719758954be3\",\n              \"relation\": \"supports\",\n              \"createdBy\": {\n                \"actorId\": \"agt_aa9fd1acaaf24477\",\n                \"actorType\": \"agent\"\n