  "decisions": [
    {
      "id": "dec_f09b0b6a950d4c0b",
      "workspace_id": "ws_50a315301f434e6b",
      "summary": "Mitigate by reverting the eu-west-1 POST /orders/submit route chg-eu-2048 from checkout-v2-eu back to checkout-v1-eu, and keep rollout-842 paused until checkout-v2-eu has registered healthy endpoints before re-cutting.",
      "rationale": "find_392e265849f54d51 establishes the edge route, not the payments database, as the cause: at 09:16:42 chg-eu-2048 sent 100% of eu-west-1 /orders/submit traffic to checkout-v2-eu, which had zero healthy endpoints (rollout-842 paused_before_eu_endpoint_registration). checkout-v1-eu had six healthy endpoints and a 200 probe. Proposed, not approved or executed; incident commander review required before any production change.",
      "status": "proposed",
      "approved_by_actor_id": null,
