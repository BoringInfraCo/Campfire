9e9cd2eb5cd4c9a\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_59e9cd2eb5cd4c9a: Hypothesis: elevated IAD database latency is contributing to the /v1/exports timeouts. (not established)\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:35:16.058Z\",\n          \"actorId\": \"agt_f966eab3a01c47bb\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"finding\",\n          \"objectId\": \"find_4228073accd84466\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_4228073accd84466: Hypothesis: the failing export requests may stall before reaching the application, or their application spans were simply not sampled. (inconclusive)\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:35:17.561Z\",\n          \"actorId\": \"agt_f966eab3a01c47bb\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"finding\",\n          \"objectId\": \"find_5c5b5222d8d34862\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_5c5b5222d8d34862: Conclusion: the cause of the IAD /v1/exports timeouts is not established by the available evidence.\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:35:38.537Z\",\n          \"actorId\": \"agt_f966eab3a01c47bb\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"task\",\n          \"objectId\": \"task_f9f0f12445ac45d2\",\n          \"changeType\": \"create\",\n          \"summary\": \"create task task_f9f0f12445ac45d2: Obtain incident-lead approval before any production change\",\n          \"materiality\": \"normal\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:35:47.145Z\",\n         