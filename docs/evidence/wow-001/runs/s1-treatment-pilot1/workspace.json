    {
      "id": "find_487c49f010e2462f",
      "workspace_id": "ws_03abec922ce74395",
      "summary": "Symptom: elevated HTTP 503 responses on POST /v1/checkouts in us-east-1, first seen in the 09:15Z window.",
      "detail": "User-visible failure: customers may be unable to complete checkout. Affected surface: route POST /v1/checkouts, region us-east-1. Start: 503s jump in the 5-minute window ending 2026-09-18T09:15:00Z (111-119 per window at 09:05/09:10 -> 3078 at 09:15; ~10.3% of ~30k requests). Latest observed: 3154 503s in the window ending 09:20Z; alert state firing. Scope: route-level; GET /health stayed normal (0 503s). Evidence ends 09:24Z. This finding states no cause.",
      "confidence": 0.95,
      "source_artifact_id": "art_7cde44ac92ff4e47",
