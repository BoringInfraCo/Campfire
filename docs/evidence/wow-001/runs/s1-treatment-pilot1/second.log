63: Rollout timeline and shape for order-api in us-east-1.\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:26:25.839Z\",\n          \"actorId\": \"agt_4c8b57d1b1a04528\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"finding\",\n          \"objectId\": \"find_67bfd43a9081400e\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_67bfd43a9081400e: Most likely cause: r184 checkout 503s come from application connection-pool exhaustion (DB_POOL_MAX=4), not from the database.\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:26:25.843Z\",\n          \"actorId\": \"agt_4c8b57d1b1a04528\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"finding\",\n          \"objectId\": \"find_6eb550ba79804a86\",\n          \"changeType\": \"create\",\n          \"summary\": \"create finding find_6eb550ba79804a86: Open uncertainties at end of evidence (09:24Z).\",\n          \"materiality\": \"high\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:26:49.131Z\",\n          \"actorId\": \"agt_4c8b57d1b1a04528\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"decision\",\n          \"objectId\": \"dec_948d10692b3f4595\",\n          \"changeType\": \"update\",\n          \"summary\": \"update decision dec_948d10692b3f4595: cites find_6eb550ba79804a86\",\n          \"materiality\": \"normal\"\n        },\n        {\n          \"cursor\": \"cf1.\",\n          \"occurredAt\": \"2026-10-08T04:26:49.251Z\",\n          \"actorId\": \"agt_4c8b57d1b1a04528\",\n          \"actorType\": \"agent\",\n          \"objectType\": \"task\",\n          \"objectId\": \"task_dd4149e1cb474603\",\n          \"changeType\": \"create\",\n          \"summary\": \"create task task_dd4149e1cb474603: Ve