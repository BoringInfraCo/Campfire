          "goalId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "update_task",
      "description": "Update shared work to its truthful current lifecycle status, title, description, or assignee. Move to in_progress when started, blocked when waiting, completed only when the completion condition is met. Pass assignee null to clear.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_progress",
              "blocked",
              "completed"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assignee": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "actorId": {
                    "type": "string"
                  },
                  "actorType": {
                    "type": "string",
                    "enum": [
                      "human",
                      "agent"
                    ]
                  }
                },
                "required": [
                  "actorId",
                  "actorType"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "taskId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "update_workspace",
      "description": "Change a workspace lifecycle status explicitly after inspecting its recorded state. Use completed only when the recorded goal is finished and no recorded work or proposal remains; completion preserves the workspace and its history. Use active for ongoing or deliberately reopened work. Archived is terminal retirement, not a synonym for completed. Quiet state alone never grants permission and never proves success.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "archived"
            ]
          }
        },
        "required": [
          "workspaceId",
          "status"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "whoami",
      "description": "Report the Campfire actor identity bound to this server process.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "withdraw_finding",
      "description": "Withdraw a finding by an explicit transition. It does not edit the old assertion.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "findingId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "findingId",
          "reason"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ]
}
